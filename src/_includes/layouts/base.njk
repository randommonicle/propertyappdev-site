<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
{%- if noindex %}
  <meta name="robots" content="noindex">
{%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
{%- if page.url == "/" %}
  <meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
{%- endif %}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0a0f1a">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/css/style.css' | hashed }}">
{%- if schemaType %}
  <script type="application/ld+json">
{% structuredData { url: page.url, title: title, description: description, schemaType: schemaType, updated: updated, image: ogImage } %}
  </script>
{%- endif %}
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header">
    <nav class="nav" aria-label="Main navigation">
      <div class="nav__inner container">
        <a href="#home" class="nav__logo" aria-label="Ben Graham — home">BG</a>
        <button class="nav__toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="nav-links">
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
        </button>
        <ul class="nav__links" id="nav-links" role="list">
          <li><a href="#about" class="nav__link">About</a></li>
          <li><a href="#projects" class="nav__link">Projects</a></li>
          <li><a href="#contact" class="nav__link">Contact</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main id="main-content">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <p class="site-footer__copy">&copy; <span id="footer-year"></span> Ben Graham</p>
      <nav class="site-footer__nav" aria-label="Footer navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </footer>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lightbox__close" id="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="">
  </div>

  <script src="{{ '/js/main.js' | hashed }}"></script>
  <!-- Cloudflare Web Analytics -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareBeaconToken }}"}'></script>
</body>
</html>
